# boat.dev API key (boat api-key create). Agents also need a Claude or ChatGPT key/subscription on boat's Agents & Proxying page.
BOAT_API_KEY=
BOAT_PROVIDER=claude
# Model for the harness, e.g. claude-opus-5-5. Empty uses the harness default.
BOAT_MODEL=
# Optional saved snapshot each claim's sandbox starts from.
BOAT_SNAPSHOT=
# The boat trial allows 2 sandboxes at once; the $20 plan allows 100.
MAX_PARALLEL=2
MAX_CLAIMS=4
CLAIM_MINUTES=8

# context.dev secret key (context.dev/dashboard/api-keys)
CONTEXT_DEV_API_KEY=

# NY Token Exchange / TrustedRouter key
NYTE_API_KEY=
NYTE_BASE_URL=https://api.trustedrouter.com/v1
NYTE_MODEL=trustedrouter/confidential
